generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler/PgBouncer) usada solo por `prisma migrate`:
  // el pooler de transacciones de Supabase no soporta el advisory lock que
  // Prisma Migrate necesita, y el build queda colgado esperando.
  directUrl = env("DIRECT_URL")
}

// Registro de auditoría de acciones administrativas. userName/userRole se
// guardan como texto plano (no una relación) a propósito: un usuario puede
// borrarse más adelante y el historial de qué hizo debe seguir legible.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  userRole   Role?
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// Permisos por rol, administrables desde /admin/permisos (Socio/Admin).
// Admin nunca tiene restricciones (no genera filas acá, se resuelve en
// código): esta tabla solo cubre Socio/Encargado/Esteticista, para poder
// prender/apagar accesos sin tocar código. `permission` es una clave de
// texto libre (ej. "empleados.ver") definida en lib/permissions.ts.
model RolePermission {
  id         String   @id @default(cuid())
  role       Role
  permission String
  allowed    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
}

enum Role {
  SOCIO
  ADMIN
  ENCARGADO
  ESTETICISTA
}

// MVP3: estado de un turno. RESERVADO/CONFIRMADO ocupan el horario del
// profesional; ATENDIDO se llega solo al registrar la sesión vinculada
// (nunca se marca a mano); CANCELADO/NO_ASISTIO liberan el horario.
enum AppointmentStatus {
  RESERVADO
  CONFIRMADO
  ATENDIDO
  CANCELADO
  NO_ASISTIO
}

enum AppointmentSource {
  MANUAL
  WHATSAPP
}

enum AlertType {
  TURNO_CREADO
  TURNO_MODIFICADO
  TURNO_CANCELADO
  TURNO_BORRADO
  CONSULTA_DERIVADA
}

// MVP4: canal de una conversación con el asistente de IA. SIMULATED = chat
// de prueba dentro del admin; WHATSAPP = mensaje real vía Meta Cloud API.
// El resto del sistema (loop del agente, historial, alertas) nunca pregunta
// en qué canal está — así no hace falta rediseñar nada al conectar
// WhatsApp real.
enum ConversationChannel {
  SIMULATED
  WHATSAPP
}

enum ConversationStatus {
  ACTIVE
  NEEDS_HUMAN
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum DiscountType {
  MONTO
  PORCENTAJE
}

enum PaymentMethod {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
  HEALTH_RECORD
}

// Usuario del panel de administración.
// MVP2: se agrega `role` (Socio / Encargado / Esteticista). El Socio no
// tiene `employee` asociado (no es "personal"); Encargado/Esteticista sí.
model AdminUser {
  id                     String          @id @default(cuid())
  email                  String          @unique
  passwordHash           String
  name                   String
  role                   Role            @default(ESTETICISTA)
  active                 Boolean         @default(true)
  employee               Employee?
  clientSessionsAttended ClientSession[] @relation("AttendedBy")
  schedules              Schedule[]
  timeOffs               TimeOff[]
  appointments           Appointment[]   @relation("AppointmentProfessional")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// Horario semanal recurrente de un profesional (Esteticista o Encargado que
// también atiende). Lo administra Encargado/Socio/Admin, nunca el propio
// profesional.
model Schedule {
  id          String    @id @default(cuid())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  adminUserId String
  dayOfWeek   Int // 0 = domingo ... 6 = sábado
  startMinute Int // minutos desde medianoche, ej. 09:00 = 540
  endMinute   Int
  createdAt   DateTime  @default(now())

  @@index([adminUserId, dayOfWeek])
}

// Excepción puntual al horario (día libre, licencia, vacaciones, permiso por
// horas). Cubre el rango [startDate, endDate] completo; startMinute/endMinute
// nulos = todo el día, y si están cargados acotan la excepción a esa franja
// horaria dentro de cada día del rango (ej. permiso de 09:00 a 13:00).
// adminUserId nulo = aplica a todos los profesionales (ej. un feriado).
model TimeOff {
  id          String     @id @default(cuid())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  adminUserId String?
  startDate   DateTime
  endDate     DateTime
  startMinute Int?
  endMinute   Int?
  reason      String?
  createdAt   DateTime   @default(now())

  @@index([adminUserId, startDate])
}

model Appointment {
  id                    String               @id @default(cuid())
  client                Client               @relation(fields: [clientId], references: [id])
  clientId              String
  professional          AdminUser            @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  professionalId        String
  services              AppointmentService[]
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus    @default(RESERVADO)
  source                AppointmentSource    @default(MANUAL)
  forcedOutsideSchedule Boolean              @default(false)
  cancelReason          String?
  notes                 String?
  session               ClientSession?
  createdByUserId       String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([professionalId, startAt])
  @@index([clientId, startAt])
  @@index([status])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     String
  // "Foto" del precio al momento de reservar (y de la promo vigente, si el
  // servicio quedaba cubierto por alguna) — para poder honrar lo que se le
  // dijo al cliente aunque el precio o la promo cambien antes de la
  // atención real. Se resuelve igual que en Facturas (lib/pricing.ts), pero
  // detectando la promo automáticamente en vez de que el usuario la elija,
  // porque reservar un turno no tiene ningún paso de selección de promo.
  priceAtBooking       Decimal    @db.Decimal(10, 2)
  promotionAtBooking   Promotion? @relation(fields: [promotionAtBookingId], references: [id])
  promotionAtBookingId String?
}

// Bandeja de alertas del panel (creación/modificación/cancelación de
// turnos). appointmentId queda como texto plano, no relación: un turno
// borrado por Admin debe seguir siendo legible en la alerta histórica
// (mismo criterio que AuditLog.userId).
model Alert {
  id                   String            @id @default(cuid())
  type                 AlertType
  appointmentId        String?
  message              String
  source               AppointmentSource @default(MANUAL)
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  createdAt            DateTime          @default(now())

  @@index([acknowledgedAt, createdAt])
}

model Employee {
  id            String                 @id @default(cuid())
  adminUser     AdminUser              @relation(fields: [adminUserId], references: [id])
  adminUserId   String                 @unique
  firstName     String
  lastName      String
  address       String?
  birthDate     DateTime?
  documentId    String?
  phone         String?
  cvUrl         String?
  active        Boolean                @default(true)
  salaryPeriods EmployeeSalaryPeriod[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

// MVP4: una conversación por número/canal con el asistente de IA.
// `externalId` es lo único específico del canal: el wa_id (teléfono E.164)
// en WhatsApp real, o un id sintético ("sim:<algo>") en el chat de prueba.
model Conversation {
  id            String              @id @default(cuid())
  channel       ConversationChannel
  externalId    String
  client        Client?             @relation(fields: [clientId], references: [id])
  clientId      String?
  status        ConversationStatus  @default(ACTIVE)
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  messages      Message[]

  @@unique([channel, externalId])
  @@index([clientId])
  @@index([status, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model EmployeeSalaryPeriod {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  amount     Decimal   @db.Decimal(10, 2)
  validFrom  DateTime
  validTo    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([employeeId, validFrom])
}

// De dónde llegó el cliente por primera vez (para saber qué canal de
// captación funciona mejor). WHATSAPP se marca solo cuando lo crea el
// asistente de IA; el resto lo elige quien lo carga a mano en el admin.
enum ClientSource {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  REFERIDO
  PRESENCIAL
  OTRO
}

model Client {
  id              String             @id @default(cuid())
  firstName       String
  lastName        String
  birthDate       DateTime?
  sex             String?
  documentId      String?
  phone           String?
  whatsapp        String?
  email           String?
  source          ClientSource?
  notes           String?
  healthNotes     String?
  attachments     ClientAttachment[]
  sessions        ClientSession[]
  appointments    Appointment[]
  conversations   Conversation[]
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([lastName, firstName])
}

model ClientAttachment {
  id               String         @id @default(cuid())
  client           Client         @relation(fields: [clientId], references: [id])
  clientId         String
  kind             AttachmentKind
  storagePath      String
  uploadedByUserId String
  createdAt        DateTime       @default(now())
}

model ClientSession {
  id               String                 @id @default(cuid())
  client           Client                 @relation(fields: [clientId], references: [id])
  clientId         String
  attendedBy       AdminUser              @relation("AttendedBy", fields: [attendedByUserId], references: [id])
  attendedByUserId String
  sessionDate      DateTime               @default(now())
  services         ClientSessionService[]
  totalAmount      Decimal                @db.Decimal(10, 2)
  paymentMethod    PaymentMethod
  // Monto final ya cobrado con el descuento aplicado (si hubo). Se guardan
  // el tipo/valor/motivo aparte para trazabilidad — nunca se recalcula el
  // descuento a partir de otra cosa.
  discountType     DiscountType?
  discountValue    Decimal?               @db.Decimal(10, 2)
  discountReason   String?
  notes            String?
  income           Income?
  // Turno de origen (MVP3): registrar la sesión marca el turno como
  // Atendido; borrar la sesión lo devuelve a Confirmado. Null = atención
  // sin turno previo.
  appointment      Appointment?           @relation(fields: [appointmentId], references: [id])
  appointmentId    String?                @unique
  createdByUserId  String
  createdAt        DateTime               @default(now())

  @@index([clientId, sessionDate])
  @@index([attendedByUserId, sessionDate])
}

model ClientSessionService {
  id           String        @id @default(cuid())
  session      ClientSession @relation(fields: [sessionId], references: [id])
  sessionId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  serviceId    String
  promotion    Promotion?    @relation(fields: [promotionId], references: [id])
  promotionId  String?
  priceApplied Decimal       @db.Decimal(10, 2)
}

model Income {
  id            String        @id @default(cuid())
  session       ClientSession @relation(fields: [sessionId], references: [id])
  sessionId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  occurredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

model Service {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  description      String
  // Obligatoria desde MVP3: el módulo de Agenda la usa para calcular la
  // duración del turno.
  durationMinutes  Int
  price            Decimal                @db.Decimal(10, 2)
  priceFrom        Boolean                @default(false)
  images           String[]               @default([])
  // Controla si el servicio aparece en el carrusel destacado de la home
  // (distinto de `images`, que se usa en la grilla de tratamientos y en la
  // ficha del servicio).
  showInCarousel   Boolean                @default(false)
  carouselImage    String?
  status           ContentStatus          @default(DRAFT)
  order            Int                    @default(0)
  promotions       Promotion[]            @relation("PromotionServices")
  sessionLines     ClientSessionService[]
  appointmentLines AppointmentService[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, order])
}

model Promotion {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  description  String
  conditions   String?
  promoPrice   Decimal?               @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime
  images       String[]               @default([])
  status       ContentStatus          @default(DRAFT)
  order        Int                    @default(0)
  services     Service[]              @relation("PromotionServices")
  sessionLines ClientSessionService[]
  appointmentServiceLines AppointmentService[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, order])
}

model Post {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  content     String
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}
