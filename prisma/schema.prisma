generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum Role {
  SOCIO
  ENCARGADO
  ESTETICISTA
}

enum PaymentMethod {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
  HEALTH_RECORD
}

// Usuario del panel de administración.
// MVP2: se agrega `role` (Socio / Encargado / Esteticista). El Socio no
// tiene `employee` asociado (no es "personal"); Encargado/Esteticista sí.
model AdminUser {
  id                     String          @id @default(cuid())
  email                  String          @unique
  passwordHash           String
  name                   String
  role                   Role            @default(ESTETICISTA)
  active                 Boolean         @default(true)
  employee               Employee?
  clientSessionsAttended ClientSession[] @relation("AttendedBy")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Employee {
  id            String                 @id @default(cuid())
  adminUser     AdminUser              @relation(fields: [adminUserId], references: [id])
  adminUserId   String                 @unique
  firstName     String
  lastName      String
  address       String?
  birthDate     DateTime?
  documentId    String?
  phone         String?
  cvUrl         String?
  active        Boolean                @default(true)
  salaryPeriods EmployeeSalaryPeriod[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model EmployeeSalaryPeriod {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  amount     Decimal   @db.Decimal(10, 2)
  validFrom  DateTime
  validTo    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([employeeId, validFrom])
}

model Client {
  id              String             @id @default(cuid())
  firstName       String
  lastName        String
  birthDate       DateTime?
  sex             String?
  documentId      String?
  phone           String?
  whatsapp        String?
  email           String?
  notes           String?
  healthNotes     String?
  attachments     ClientAttachment[]
  sessions        ClientSession[]
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([lastName, firstName])
}

model ClientAttachment {
  id               String         @id @default(cuid())
  client           Client         @relation(fields: [clientId], references: [id])
  clientId         String
  kind             AttachmentKind
  storagePath      String
  uploadedByUserId String
  createdAt        DateTime       @default(now())
}

model ClientSession {
  id               String                 @id @default(cuid())
  client           Client                 @relation(fields: [clientId], references: [id])
  clientId         String
  attendedBy       AdminUser              @relation("AttendedBy", fields: [attendedByUserId], references: [id])
  attendedByUserId String
  sessionDate      DateTime               @default(now())
  services         ClientSessionService[]
  totalAmount      Decimal                @db.Decimal(10, 2)
  paymentMethod    PaymentMethod
  notes            String?
  income           Income?
  createdByUserId  String
  createdAt        DateTime               @default(now())

  @@index([clientId, sessionDate])
  @@index([attendedByUserId, sessionDate])
}

model ClientSessionService {
  id           String        @id @default(cuid())
  session      ClientSession @relation(fields: [sessionId], references: [id])
  sessionId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  serviceId    String
  promotion    Promotion?    @relation(fields: [promotionId], references: [id])
  promotionId  String?
  priceApplied Decimal       @db.Decimal(10, 2)
}

model Income {
  id            String        @id @default(cuid())
  session       ClientSession @relation(fields: [sessionId], references: [id])
  sessionId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  occurredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

model Service {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  description     String
  durationMinutes Int?
  price           Decimal                @db.Decimal(10, 2)
  priceFrom       Boolean                @default(false)
  images          String[]               @default([])
  status          ContentStatus          @default(DRAFT)
  order           Int                    @default(0)
  promotions      Promotion[]            @relation("PromotionServices")
  sessionLines    ClientSessionService[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, order])
}

model Promotion {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  description  String
  conditions   String?
  promoPrice   Decimal?               @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime
  images       String[]               @default([])
  status       ContentStatus          @default(DRAFT)
  order        Int                    @default(0)
  services     Service[]              @relation("PromotionServices")
  sessionLines ClientSessionService[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, order])
}

model Post {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  content     String
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}
