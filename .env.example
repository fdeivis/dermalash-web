# Cadena de conexión Postgres. En producción: la conexión "pooled" (con
# pgbouncer, puerto 6543) de tu proyecto Supabase — la que usa la app en
# runtime (Project Settings > Database > Connection string > URI).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dermalash"

# Conexión DIRECTA (sin pooler, puerto 5432) — la usa `prisma migrate` para
# aplicar migraciones; el pooler de Supabase no soporta el advisory lock
# que Prisma Migrate necesita. En local, dejarla igual a DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dermalash"

# NextAuth (login del panel de administración)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-valor-random-largo"

# Supabase: usado como storage de imágenes (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Bucket PRIVADO (marcarlo como "private" en Supabase Storage, no público):
# guarda fotos, documentos y antecedentes de salud de clientes. Se accede
# solo mediante URLs firmadas generadas desde el servidor.
SUPABASE_PRIVATE_BUCKET="private"

# Número de WhatsApp de contacto (formato internacional, sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER="51999999999"

# MVP4: asistente de WhatsApp con IA (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=""
# Opcional: para ajustar el modelo sin redeploy. Si se omite, usa claude-sonnet-5.
ANTHROPIC_MODEL=""
